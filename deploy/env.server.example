# .env template — copy to your deployed app root as `.env` and fill in the
# secrets marked TODO and the paths marked <adjust-me>.
#
# IMPORTANT: TLS_CERT_PATH/TLS_KEY_PATH and BACKUP_LOCAL_ROOT MUST match your
# actual APP_DIR and Tailscale machine name — this is a generic example, not
# a value to copy verbatim between servers/accounts. A stale/mismatched
# BACKUP_LOCAL_ROOT fails silently with EACCES on every nginx config backup
# rather than erroring at startup, since the directory may still exist (just
# under the wrong owner) from a previous install.
#
#   cp deploy/env.server.example .env   # then fill in the secrets marked TODO
#   openssl rand -base64 48   # run twice, once per JWT secret below
#   sudo tailscale cert <your-machine>.<your-tailnet>.ts.net

NODE_ENV=production
PORT=8443
HOST=0.0.0.0
TLS_CERT_PATH=./secrets/tailscale-cert/<your-machine>.<your-tailnet>.ts.net.crt
TLS_KEY_PATH=./secrets/tailscale-cert/<your-machine>.<your-tailnet>.ts.net.key
SERVICE_USER=pwa-admin-svc

JWT_ACCESS_SECRET=TODO_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=TODO_GENERATE_WITH_OPENSSL
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TOTP_ISSUER=PiAdmin

SQLITE_PATH=./data/app.db

DOCKER_SOCKET_PATH=/var/run/docker.sock

PROXY_TYPE=nginx
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_CONF_D=/etc/nginx/conf.d
NGINX_LOG_DIR=/var/log/nginx
NGINX_BINARY_PATH=/usr/sbin/nginx
NGINX_CONFIG_BACKUP_DIR=./data/nginx-config-history
CERTBOT_LIVE_DIR=/etc/letsencrypt/live

OS_MODULE_ENABLED=true
APT_ALLOW_INSTALL_REMOVE=false
APT_JOB_LOG_DIR=./data/apt-job-logs

NETWORK_MODULE_ENABLED=true
FAIL2BAN_ENABLED=true
FAIL2BAN_CLIENT_PATH=/usr/bin/fail2ban-client
FAIL2BAN_DEFAULT_JAIL=sshd
ANALYTICS_LOG_LINE_CAP=200000

# Local backup root — MUST match this server's actual APP_DIR (see warning
# above). Adjust if you want backups on a specific mount instead.
BACKUP_LOCAL_ROOT=<your-app-dir>/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MIN_COPIES=3

# Google Drive: OAuth2 against a personal Drive (service accounts have no quota
# on non-Workspace Drives). Client ID/secret from a Desktop-app OAuth client in
# Google Cloud Console; one-time authorization done via the Backups screen.
GDRIVE_ENABLED=false
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_TOKEN_PATH=./secrets/gdrive-oauth-token.json
GDRIVE_ROOT_FOLDER_ID=

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1m

ALERT_TEMP_WARN_C=70
ALERT_TEMP_CRIT_C=80
ALERT_DISK_WARN_PCT=80
ALERT_DISK_CRIT_PCT=90
